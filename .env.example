# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Safe to expose in the browser (protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses Row Level Security — full read/write on every table.
# Never prefix this with VITE_ (that would bundle it into the public JS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin page gate
VITE_ADMIN_ANSWER=iti

# --- Braino chat widget ---------------------------------------------------
# Public by design; access is gated by allowed_origins on Braino's side.
# Get it by running embed-register (Phase 1) with the Braino account owner's
# Supabase user JWT. The widget stays off until this is set.
VITE_BRAINO_SITE_ID=

# SERVER ONLY. Returned once by embed-configure-bridge (Phase 4). Used to
# verify the HMAC on every call to /api/braino-bridge.
BRAINO_BRIDGE_SECRET=

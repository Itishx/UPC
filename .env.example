# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Safe to expose in the browser (protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses Row Level Security — full read/write on every table.
# Never prefix this with VITE_ (that would bundle it into the public JS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin page gate
VITE_ADMIN_ANSWER=iti
